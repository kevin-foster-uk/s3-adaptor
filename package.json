{
  "name": "s3-adaptor",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "pnpm -r typecheck",
    "test": "jest",
    "compile": "pnpm format && pnpm build && pnpm typecheck && pnpm test",
    "test:watch": "jest --watch",
    "format": "prettier --write ./src",
    "lint": "eslint src --ext .ts",
    "commit": "cz",
    "prepare": "git config core.hooksPath .githooks && git config commit.template .git-commit-template.txt"
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/lib-storage": "^3.1037.0",
    "@aws-sdk/s3-request-presigner": "^3.1037.0"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@cspell/dict-node": "^5.0.9",
    "@cspell/dict-npm": "^5.2.38",
    "@cspell/dict-typescript": "^3.2.3",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "commitizen": "^4.3.1",
    "cspell": "^9.7.0",
    "cz-customizable": "^7.5.4",
    "eslint": "^8.57.0",
    "jest": "^29.0.0",
    "memfs": "^4.0.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.11",
    "typescript": "^5.0.0"
  }
}