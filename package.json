{
  "name": "s3-adaptor",
  "version": "0.1.0",
  "description": "Adapter-pattern interface for AWS S3 and local filesystem storage, with signed URLs and Express middleware",
  "license": "BSD-3-Clause",
  "author": "Kevin Foster <kevin.foster.uk@gmail.com>",
  "homepage": "https://github.com/kevin-foster-uk/s3-adaptor#readme",
  "bugs": {
    "url": "https://github.com/kevin-foster-uk/s3-adaptor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevin-foster-uk/s3-adaptor.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm build && pnpm test",
    "build": "tsc",
    "typecheck": "pnpm -r typecheck",
    "test": "jest",
    "compile": "pnpm format && pnpm build && pnpm typecheck && pnpm test",
    "test:watch": "jest --watch",
    "format": "prettier --write ./src",
    "lint": "eslint src --ext .ts",
    "commit": "cz",
    "changeset": "changeset",
    "prepare": "git config core.hooksPath .githooks && git config commit.template .git-commit-template.txt"
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/lib-storage": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@cspell/dict-node": "^5.0.9",
    "@cspell/dict-npm": "^5.2.50",
    "@cspell/dict-typescript": "^3.2.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "commitizen": "^4.3.2",
    "cspell": "^9.8.0",
    "cz-customizable": "^7.5.4",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "memfs": "^4.79.0",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  }
}
