{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2020"],
    "strict": true,
    "rootDir": "./src",
    "outDir": "dist",
    "declaration": true,
    "esModuleInterop": true,
    "types": ["node", "jest"],
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["**/*.test.ts", "src/test-utils"]
}
